import "http";
import "html";
import "json";
import "manga_models";
import "../../shared/lib_social_api";

function getGallery(page, query, filters) {
    return libSocialGetGallery(page, query, 1, filters);
}

function getConcrete(uid) {
    return libSocialGetConcrete(uid, "https://mangalib.me");
}

function getPages(uid, data) {
    return libSocialGetPages(uid, data, "https://img2.imglib.info");
}

function getImageHeaders(uid) {
    headers = getHeaders();
    return {
        "user-agent": headers["user-agent"],
        "Accept": "image/avif,image/webp,*/*",
        "referer": "https://mangalib.me/",
    };
}

function passProtector(body, headers, cookies) {
    libSocialPassProtector(body, headers, cookies, 1, "https://mangalib.me");
}

function passWebBrowserInterceptorController(controller) {
    registerInterceptorController(controller);
}
