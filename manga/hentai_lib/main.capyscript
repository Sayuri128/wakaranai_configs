import "http";
import "html";
import "json";
import "manga_models";
import "../../shared/lib_social_api";

function getGallery(page, query, filters) {
    return libSocialGetGallery(page, query, 4, filters);
}

function getConcrete(uid) {
    return libSocialGetConcrete(uid, "https://hentailib.me");
}

function getPages(uid, data) {
    return libSocialGetPages(uid, data, "https://img2h.hentaicdn.org");
}

function getImageHeaders(uid) {
    headers = getHeaders();
    return {
        "user-agent": headers["user-agent"],
        "Authorization": headers["Authorization"],
        "Accept": "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8",
        "Referer": "https://hentailib.me/",
    };
}

function passProtector(body, headers, cookies) {
    libSocialPassProtector(body, headers, cookies, 4, "https://hentailib.me");
}

function passWebBrowserInterceptorController(controller) {
    registerInterceptorController(controller);
}
