import "http";
import "json";
import "date";
import "manga_models";

function getCoverUrl(mangaId, relationships) {
    for (i = 0; i < relationships.length; i = i + 1) {
        rel = relationships[i];
        if (rel["type"] == "cover_art") {
            fileName = rel["attributes"]["fileName"];
            return "https://uploads.mangadex.org/covers/" + mangaId + "/" + fileName + ".512.jpg";
        }
    }
    return "";
}

function getMangaTitle(titleMap) {
    en = titleMap["en"];
    if (en != null) {
        return en;
    }
    return titleMap.values.first;
}

function getGallery(page, query, filters) {
    limit = 20;

    params = {
        "limit": limit,
        "offset": limit * page,
        "includes": ["cover_art"]
    };

    if (query != "") {
        params["title"] = query;
    }

    for (i = 0; i < filters.length; i = i + 1) {
        filterData = filters[i];
        filter = filterData["filter"];
        type = filter["type"];

        if (type == "ONE_OF_MULTIPLE" || type == "ONE_OF_ANY" || type == "MULTIPLE_OF_ANY") {
            params[filter["param"]] = filterData["selected"];
        } else if (type == "MULTIPLE_OF_MULTIPLE") {
            selected = [];
            selectedItems = filterData["selected"];
            for (j = 0; j < selectedItems.length; j = j + 1) {
                selected.push(selectedItems[j][0]);
            }
            params[filter["param"]] = selected;
        } else if (type == "SWITCHER") {
            if (filterData["on"]) {
                params[filter["param"]] = "AND";
            } else {
                params[filter["param"]] = "OR";
            }
        }
    }

    result = httpGet({
        "url": "https://api.mangadex.org/manga",
        "params": params,
        "paths": {},
        "throughWeb": false,
        "headers": {}
    });

    decoded = jsonDecode(result["body"]);
    data = decoded["data"];

    mangas = [];

    for (i = 0; i < data.length; i = i + 1) {
        manga = data[i];
        uid = manga["id"];
        title = getMangaTitle(manga["attributes"]["title"]);
        cover = getCoverUrl(uid, manga["relationships"]);

        mangas.push(buildGallery({
            "uid": uid,
            "title": title,
            "cover": cover,
            "data": {}
        }));
    }

    return mangas;
}

function handleChapterItem(chapter) {
    uid = chapter["id"];
    attr = chapter["attributes"];

    prefix = "";
    if (attr["volume"] != null) {
        prefix = "Volume " + attr["volume"];
    }
    if (attr["chapter"] != null) {
        if (prefix.isNotEmpty) {
            prefix = prefix + " ";
        }
        prefix = prefix + "Chapter " + attr["chapter"];
    }

    title = attr["title"];
    if (title == null || title == "") {
        title = prefix;
    } else {
        if (prefix.isNotEmpty) {
            title = prefix + " | " + title;
        }
    }

    rawDate = attr["publishAt"];
    timestamp = rawDate;
    if (rawDate != null) {
        date = parseDate(rawDate);
        if (date != null) {
            formatter = createDateFormatter("yyyy-MM-dd HH:mm");
            timestamp = formatter.format(date);
        }
    }

    return buildChapter({
        "uid": uid,
        "title": title,
        "timestamp": timestamp,
        "data": {}
    });
}

function fetchChaptersPage(mangaId, offset) {
    return httpGet({
        "url": "https://api.mangadex.org/manga/:mangaId/feed",
        "params": {
            "limit": 100,
            "offset": offset,
            "translatedLanguage": ["en"],
            "order": {
                "volume": "asc",
                "chapter": "asc"
            }
        },
        "paths": {
            ":mangaId": mangaId
        },
        "headers": {},
        "throughWeb": false
    });
}

function getChapters(uid) {
    chapters = [];
    limit = 100;
    total = 1;

    for (offset = 0; offset < total; offset = offset + limit) {
        response = fetchChaptersPage(uid, offset);
        decoded = jsonDecode(response["body"]);
        total = decoded["total"];
        data = decoded["data"];

        for (i = 0; i < data.length; i = i + 1) {
            chapter = data[i];
            if (chapter["attributes"]["externalUrl"] == null) {
                chapters.push(handleChapterItem(chapter));
            }
        }
    }

    return chapters;
}

function getConcrete(uid) {
    result = httpGet({
        "url": "https://api.mangadex.org/manga/:uid",
        "params": {
            "includes": ["cover_art"]
        },
        "paths": {
            ":uid": uid
        },
        "throughWeb": false,
        "headers": {}
    });

    body = jsonDecode(result["body"]);
    data = body["data"];
    attr = data["attributes"];

    title = getMangaTitle(attr["title"]);

    description = "";
    descMap = attr["description"];
    if (descMap != null) {
        enDesc = descMap["en"];
        if (enDesc != null) {
            description = enDesc;
        } else if (descMap.values.isNotEmpty) {
            description = descMap.values.first;
        }
    }

    cover = getCoverUrl(uid, data["relationships"]);

    rawTags = attr["tags"];
    tags = [];
    for (i = 0; i < rawTags.length; i = i + 1) {
        tagName = rawTags[i]["attributes"]["name"]["en"];
        if (tagName != null) {
            tags.push(tagName);
        }
    }

    return buildConcrete({
        "uid": uid,
        "title": title,
        "description": description,
        "cover": cover,
        "tags": tags,
        "status": null,
        "alternativeTitles": [],
        "groups": [
            buildChapterGroups({
                "title": "Default",
                "elements": getChapters(uid)
            })
        ]
    });
}

function getPages(uid) {
    result = httpGet({
        "url": "https://api.mangadex.org/at-home/server/:chapterId",
        "params": {},
        "paths": {
            ":chapterId": uid
        },
        "throughWeb": false,
        "headers": {}
    });

    body = jsonDecode(result["body"]);

    if (body["result"] != "ok") {
        return buildPages({
            "uid": uid,
            "value": []
        });
    }

    baseUrl = body["baseUrl"];
    hash = body["chapter"]["hash"];
    data = body["chapter"]["data"];

    value = [];
    for (i = 0; i < data.length; i = i + 1) {
        value.push(baseUrl + "/data/" + hash + "/" + data[i]);
    }

    return buildPages({
        "uid": uid,
        "value": value
    });
}

function getImageHeaders(uid) {
    return {};
}
