import "http";
import "json";
import "html";
import "manga_models";
import "converter";


function getGallery(page, query, filters) {

    result = null;

    if(query == "") {
        result = httpGet({
            "url": "https://manga.in.ua/mangas/page/" + parseString(page),
            "params": {},
            "paths": {},
            "headers": {},
            "throughWeb": true
        });
    } else {
        result = httpPost({
            "url": "https://manga.in.ua/index.php",
            "params": {
                "do": "search",
                "subaction": "search",
                "full_search": "0",
                "story": query,
                "search_start": page
            },
            "paths": {},
            "body": {},
            "headers": {},
            "throughWeb": false
        });
    }

    document = createHTMLParser(result["body"]);

    movie = document.getElementsByClassName("movie");

    items = [];

    for(i = 0; i < movie.length - 1; i = i + 1) {
        e = movie[i];

        uid = "";
        title = "";
        cover = "";

        if(e.getElementsByTagName("h3")[0] == null ||
           e.getElementsByTagName("h3")[0].getElementsByTagName("a")[0] == null ||
           e.getElementsByTagName("h3")[0].getElementsByTagName("a")[0].attributes["href"] == null) {
           uid = "";
        } else {
            uid = e.getElementsByTagName("h3")[0].getElementsByTagName("a")[0].attributes["href"];
        }

        if(e.getElementsByTagName("h3")[0] == null ||
            e.getElementsByTagName("h3")[0].getElementsByTagName("a")[0] == null) {
            title = "";
        } else {
            title = e.getElementsByTagName("h3")[0].getElementsByTagName("a")[0].text;
        }

        if(e.getElementsByTagName("figure").isEmpty) {
            cover = "";
        } else if (e.getElementsByTagName("figure")[0] == null ||
            e.getElementsByTagName("figure")[0].getElementsByTagName("img")[0] == null
        ) {
            cover = "";
        } else {
            dataSrc = e.getElementsByTagName("figure")[0]
                .getElementsByTagName("img")[0].attributes["data-src"];
            if(dataSrc == null) {
                cover = "https://manga.in.ua/" + e.getElementsByTagName("figure")[0]
                .getElementsByTagName("img")[0].attributes["src"];
            } else {
                cover = "https://manga.in.ua/" + dataSrc;
            }
        }

        if(uid != "") {
            items.push(buildGallery({
                "uid": uid,
                "title": title,
                "cover": cover,
                "data": {}
            }));
        }
    }

    return items;

}

function getConcrete(uid) {

    result = httpGet({
        "url": uid,
        "params": {},
        "paths": {},
        "headers": {},
        "throughWeb": true
    });

    jsScript = `
        let fun = () => {
            return new Promise((resolve) => {
                let attempts = 0;
                const check = () => {
                    attempts++;
                    const el = document.getElementById('linkstocomics');
                    if (el && typeof site_login_hash !== 'undefined') {
                        const news_id = el.getAttribute('data-news_id');
                        const news_category = el.getAttribute('data-news_category');
                        const form = new URLSearchParams({
                            action: 'show',
                            news_id: news_id ? news_id.toString() : '',
                            news_category: news_category ? news_category.toString() : '',
                            this_link: news_category === '54' ? (el.getAttribute('data-this_link') || '') : '',
                            user_hash: site_login_hash
                        });
                        fetch('/engine/ajax/controller.php?mod=load_chapters', {
                            method: 'POST',
                            body: form,
                            headers: {'X-Requested-With': 'XMLHttpRequest'}
                        })
                            .then((r) => r.text())
                            .then((html) => resolve({html: html}))
                            .catch((e) => resolve({html: 'error'}));
                    } else if (attempts < 20) {
                        setTimeout(check, 500);
                    } else {
                        resolve(null);
                    }
                };
                check();
            });
        }

        return fun();
    `

    chaptersResult = executeJsScript({"code": jsScript});
    if(chaptersResult == null) {
        throw "manga.in.ua: chapter list block not found";
    }
    chaptersHtml = chaptersResult["html"];
    if(chaptersHtml == "empty" || chaptersHtml == "hash" || chaptersHtml == "error") {
        throw "manga.in.ua: failed to load chapters (" + chaptersHtml + ")";
    }

    pageDocument = createHTMLParser(result["body"]);
    document = createHTMLParser(chaptersHtml);

    chaptersTags = document.getElementsByClassName("ltcitems");
    chapters = [];

    for(i = 0; i < chaptersTags.length; i = i + 1) {
        fastNav = chaptersTags[i].getElementsByClassName("forfastnavigation");
        if(fastNav.isEmpty) {
            continue;
        }
        chapterUid = fastNav[0].attributes["href"];
        chapterTitle = fastNav[0].text;
        ltcright = chaptersTags[i].getElementsByClassName("ltcright");
        timestamp = "";
        if(ltcright.length > 0) {
            timestamp = ltcright[0].text;
        }
        chapters.push(buildChapter({
            "uid": chapterUid,
            "title": chapterTitle,
            "timestamp": timestamp,
            "data": {}
        }));
    }

    cover = "";
    posterEls = pageDocument.getElementsByClassName("item__full-sidebar--poster");
    if(posterEls.length > 0) {
        imgEls = posterEls[0].getElementsByTagName("img");
        if(imgEls.length > 0) {
            cover = "https://manga.in.ua" + imgEls[0].attributes["src"];
        }
    }

    tags = [];
    sectionEls = pageDocument.getElementsByClassName("item__full-sidebar--section");
    if(sectionEls.length > 1) {
        tagsDocs = sectionEls[1].getElementsByClassName("item__full-sideba--header");
        for(i = 0; i < tagsDocs.length; i = i + 1) {
            e = tagsDocs[i];
            if(e.text.contains("Жанри")) {
                genresDocs = e.getElementsByTagName("a");
                for(j = 0; j < genresDocs.length; j = j + 1) {
                    tags.push(genresDocs[j].text);
                }
            }
        }
    }

    description = "";
    descEls = pageDocument.getElementsByClassName("item__full-description");
    if(descEls.length > 0) {
        description = descEls[0].text;
    }

    concreteTitle = "";
    titleEls = pageDocument.getElementsByClassName("UAname");
    if(titleEls.length > 0) {
        concreteTitle = titleEls[0].text;
    }

    return buildConcrete({
        "uid": uid,
        "title": concreteTitle,
        "description": description,
        "cover": cover,
        "tags": tags,
        "alternativeTitles": [],
        "status": null,
        "groups": [
            buildChapterGroups({
                "title": "Default",
                "elements": chapters
            })
        ]
    });
}

function getPages(uid) {

    result = httpGet({
        "url": uid,
        "params": {},
        "paths": {},
        "headers": {},
        "throughWeb": true
    });

    jsScript = `
        let fun = () => {
            return new Promise((resolve) => {
                let attempts = 0;
                const check = () => {
                    attempts++;
                    const el = document.getElementById('comics');
                    if (el && typeof site_login_hash !== 'undefined') {
                        const query = new URLSearchParams({
                            mod: 'load_chapters_image',
                            news_id: el.getAttribute('data-news_id').toString(),
                            action: 'show',
                            user_hash: site_login_hash
                        });
                        fetch('/engine/ajax/controller.php?' + query.toString(), {
                            headers: {'X-Requested-With': 'XMLHttpRequest'}
                        })
                            .then((r) => r.text())
                            .then((html) => resolve({html: html}))
                            .catch((e) => resolve({html: ''}));
                    } else if (attempts < 20) {
                        setTimeout(check, 500);
                    } else {
                        resolve(null);
                    }
                };
                check();
            });
        }

        return fun();
    `

    pagesResult = executeJsScript({"code": jsScript});

    if(pagesResult == null) {
        return buildPages({ "uid": uid, "value": [] });
    }

    document = createHTMLParser(pagesResult["html"]);

    value = [];

    images = document.getElementsByTagName("img");

    for(i = 0; i < images.length; i = i + 1) {
        dataSrc = images[i].attributes["data-src"];
        if(dataSrc != null) {
            value.push(dataSrc);
        }
    }

    return buildPages({ "uid": uid,
                        "value": value });

}

function getImageHeaders(uid) {

    headers = getHeaders();

    return {
        "user-agent": headers["user-agent"],
        "Accept": "image/avif,image/webp,*/*",
        "referer": "https://manga.in.ua/",
    };
}

function passProtector(body, headers, cookies) {
    useHeaders({"headers": headers});
}

function passWebBrowserInterceptorController(controller) {
    registerInterceptorController(controller);
}
