import "http";
import "json";
import "manga_models";
import "converter";

function handleMangaItem(manga) {
    uid = parseString(manga["id"]);

    title = manga["english_title"];
    if (title == null) {
        title = manga["japanese_title"];
    }
    if (title == null) {
        title = "";
    }

    cover = "https://t.nhentai.net/" + manga["thumbnail"];

    return buildGallery({
        "uid": uid,
        "title": title,
        "cover": cover,
        "data": manga
    });
}


function getGallery(page, query, filters) {
    result = httpGet({
        "url": "https://nhentai.net/api/v2/galleries?page=" + parseString(page) + "&limit=25",
        "params": {},
        "paths": {},
        "headers": {},
        "throughWeb": false
    });

    decoded = jsonDecode(result["body"]);
    data = decoded["result"];

    mangas = [];

    for(i = 0; i < data.length; i = i + 1) {
        mangas.push(handleMangaItem( {"manga": data[i]} ));
    }

    return mangas;
}

function getConcrete(uid) {
    result = httpGet({
        "url": "https://nhentai.net/api/v2/galleries/" + uid,
        "params": {},
        "paths": {},
        "headers": {},
        "throughWeb": false
    });

    decoded = jsonDecode(result["body"]);

    title = decoded["title"]["english"];
    if (title == null) {
        title = decoded["title"]["japanese"];
    }
    if (title == null) {
        title = decoded["title"]["pretty"];
    }
    if (title == null) {
        title = "";
    }

    cover = "https://t1.nhentai.net/" + decoded["cover"]["path"];

    tags = [];
    rawTags = decoded["tags"];
    for(i = 0; i < rawTags.length; i = i + 1) {
        tags.push(rawTags[i]["name"]);
    }

    description = "Pages: " + parseString(decoded["num_pages"]) + "\n";
    description = description + "Favorites: " + parseString(decoded["num_favorites"]);

    chapters = [];
    chapters.push(buildChapter({"uid": uid, "title": "Chapter 1", "timestamp": "", "data": {}}));

    return buildConcrete({
        "uid": uid,
        "title": title,
        "description": description,
        "cover": cover,
        "tags": tags,
        "status": null,
        "alternativeTitles": [],
        "groups": [
            buildChapterGroups({
                "title": "Default",
                "elements": chapters,
            })
        ]
    });
}

function getPages(uid) {
    result = httpGet({
        "url": "https://nhentai.net/api/v2/galleries/" + uid,
        "params": {},
        "paths": {},
        "headers": {},
        "throughWeb": false
    });

    decoded = jsonDecode(result["body"]);
    pages = decoded["pages"];

    value = [];

    for(i = 0; i < pages.length; i = i + 1) {
        value.push("https://i1.nhentai.net/" + pages[i]["path"]);
    }

    return buildPages({"uid": uid, "value": value});
}

function getImageHeaders(uid) {
    return {};
}

function passProtector(body, headers, cookies) {
    headers["Accept"] = "*/*";
    headers["Connection"] = "keep-alive";

    useHeaders({"headers": headers});
}
