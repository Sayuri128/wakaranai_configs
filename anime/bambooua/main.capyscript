import "http";
import "html";
import "json";
import "converter";
import "errors";
import "anime_models";

function bambooBaseUrl() {
    return "https://bambooua.com";
}

function bambooUserAgent() {
    return "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36";
}

function bambooRequest(path, label, emptyOnMissing) {
    response = httpGet({
        "url": bambooBaseUrl() + path,
        "params": {},
        "paths": {},
        "headers": {
            "User-Agent": bambooUserAgent(),
            "Accept": "text/html,application/xhtml+xml",
            "Accept-Language": "uk-UA,uk;q=0.9"
        },
        "throughWeb": false
    });
    statusCode = response["statusCode"];
    if(statusCode == 200) {
        return response["body"];
    }
    if(statusCode == 404) {
        if(emptyOnMissing) {
            return "";
        }
        throwSourceError("notFound", "BambooUA has no such page (" + label + ")");
    }
    if(statusCode == 429) {
        throwSourceError("rateLimited", "BambooUA asks to slow down (" + label + ")");
    }
    if(statusCode == 403 || statusCode >= 500) {
        throwSourceError("sourceDown", "BambooUA answered HTTP " + parseString(statusCode) + " (" + label + ")");
    }
    throw "HTTP " + parseString(statusCode) + " (" + label + ")";
}

function bambooAttribute(element, attributeName) {
    elementAttributes = element.attributes;
    if(elementAttributes[attributeName] == null) {
        return "";
    }
    return parseString(elementAttributes[attributeName]);
}

function bambooAbsolute(link) {
    if(link == "" || link.startsWith("http")) {
        return link;
    }
    if(link.startsWith("//")) {
        return "https:" + link;
    }
    return bambooBaseUrl() + link;
}

function bambooUid(href) {
    marker = "bambooua.com/";
    markerAt = href.indexOf(marker);
    if(markerAt < 0) {
        return "";
    }
    return href.substring(markerAt + marker.length).split("?")[0];
}

function bambooListPath(page, filters, feed) {
    section = "lastnews";
    if(feed != null && feed != "") {
        section = feed;
    }
    if(filters != null) {
        chosenGenre = "";
        chosenStatus = "";
        for(i = 0; i < filters.length; i = i + 1) {
            filterInfo = filters[i]["filter"];
            selected = filters[i]["selected"];
            if(filterInfo == null || selected == null || selected == "" || selected == "any") {
                continue;
            }
            if(filterInfo["param"] == "genre") {
                chosenGenre = parseString(selected);
            }
            if(filterInfo["param"] == "status") {
                chosenStatus = parseString(selected);
            }
        }
        if(chosenGenre != "") {
            section = "zhanr/" + chosenGenre;
        } else if(chosenStatus != "") {
            section = chosenStatus;
        }
    }
    if(page > 1) {
        return "/" + section + "/page/" + parseString(page) + "/";
    }
    return "/" + section + "/";
}

function bambooCards(body) {
    items = [];
    if(body == "") {
        return items;
    }
    document = createHTMLParser(body);
    cards = document.querySelectorAll(".cat-item");
    seen = [];
    for(c = 0; c < cards.length; c = c + 1) {
        link = cards[c].querySelector("a.link-title");
        if(link == null) {
            continue;
        }
        uid = bambooUid(bambooAttribute(link, "href"));
        if(uid == "" || seen.contains(uid)) {
            continue;
        }
        seen.push(uid);
        title = "";
        heading = cards[c].querySelector(".title h2");
        if(heading != null) {
            title = heading.text.trim();
        }
        coverUrl = "";
        poster = cards[c].querySelector(".poster img");
        if(poster != null) {
            coverUrl = bambooAbsolute(bambooAttribute(poster, "src"));
        }
        items.push(buildGallery({
            "uid": uid,
            "title": title,
            "cover": coverUrl,
            "data": {},
            "status": statusUndefined()
        }));
    }
    return items;
}

function getGallery(page, query, filters, feed, pageSize) {
    if(query != null && parseString(query).trim() != "") {
        searchPath = "/index.php?do=search&subaction=search&story=" + urlEncode(parseString(query).trim());
        if(page > 1) {
            searchPath = searchPath + "&search_start=" + parseString(page);
        }
        return bambooCards(bambooRequest(searchPath, "bambooua search", true));
    }
    return bambooCards(bambooRequest(bambooListPath(page, filters, feed), "bambooua list", true));
}

function bambooInfoValue(document, label) {
    blocks = document.querySelectorAll(".info-block .block");
    for(b = 0; b < blocks.length; b = b + 1) {
        spans = blocks[b].querySelectorAll("span");
        if(spans.length < 2) {
            continue;
        }
        if(spans[0].text.trim().startsWith(label)) {
            return spans[1];
        }
    }
    return null;
}

function bambooPlaylist(body) {
    marker = "const playlist = ";
    markerAt = body.indexOf(marker);
    if(markerAt < 0) {
        return [];
    }
    rest = body.substring(markerAt + marker.length);
    if(rest.startsWith("[]")) {
        return [];
    }
    endAt = rest.indexOf("}];");
    if(endAt < 0) {
        return [];
    }
    return jsonDecode(rest.substring(0, endAt + 2));
}

function bambooIsPlayable(file) {
    return file.startsWith("http") && file.contains("be_sponsors") == false;
}

function bambooIsDigits(word) {
    if(word == "") {
        return false;
    }
    for(k = 0; k < word.length; k = k + 1) {
        if("0123456789".contains(word.substring(k, k + 1)) == false) {
            return false;
        }
    }
    return true;
}

function bambooEpisodeNumber(title) {
    words = title.replaceAll("(", " ").split(" ");
    for(w = 0; w < words.length; w = w + 1) {
        word = words[w].trim();
        if(bambooIsDigits(word)) {
            return word;
        }
    }
    return null;
}

function bambooVideo(entry, prefix, trackName, position) {
    file = parseString(entry["file"]).trim();
    title = prefix + parseString(entry["title"]).trim();
    number = bambooEpisodeNumber(parseString(entry["title"]));
    if(number == null) {
        number = parseString(position);
    }
    return buildAnimeVideo({
        "uid": file,
        "src": file,
        "title": title,
        "timestamp": null,
        "type": typeDirect(),
        "data": {"track": trackName},
        "number": number
    });
}

function bambooTrackVideos(entries, trackName) {
    videos = [];
    for(e = 0; e < entries.length; e = e + 1) {
        entry = entries[e];
        if(entry["folder"] != null) {
            prefix = parseString(entry["title"]).trim() + " · ";
            inner = entry["folder"];
            for(i = 0; i < inner.length; i = i + 1) {
                if(inner[i]["file"] != null && bambooIsPlayable(parseString(inner[i]["file"]))) {
                    videos.push(bambooVideo(inner[i], prefix, trackName, videos.length + 1));
                }
            }
            continue;
        }
        if(entry["file"] != null && bambooIsPlayable(parseString(entry["file"]))) {
            videos.push(bambooVideo(entry, "", trackName, videos.length + 1));
        }
    }
    return videos;
}

function bambooGroups(body, fallbackTitle) {
    playlist = bambooPlaylist(body);
    groups = [];
    looseEntries = [];
    for(t = 0; t < playlist.length; t = t + 1) {
        track = playlist[t];
        if(track["folder"] == null) {
            looseEntries.push(track);
            continue;
        }
        trackName = parseString(track["title"]).trim();
        videos = bambooTrackVideos(track["folder"], trackName);
        if(videos.length > 0) {
            groups.push(buildAnimeVideoGroup({
                "title": trackName,
                "videos": videos
            }));
        }
    }
    if(looseEntries.length > 0) {
        videos = bambooTrackVideos(looseEntries, fallbackTitle);
        if(videos.length > 0) {
            groups.push(buildAnimeVideoGroup({
                "title": fallbackTitle,
                "videos": videos
            }));
        }
    }
    return groups;
}

function getConcrete(uid, data) {
    body = bambooRequest("/" + uid, "bambooua title", false);
    document = createHTMLParser(body);
    heading = document.querySelector("h1");
    if(heading == null) {
        throw "BambooUA returned an unexpected page (bambooua title)";
    }
    alternativeTitles = [];
    originalElement = bambooInfoValue(document, "Оригінальна назва");
    if(originalElement != null) {
        originalNames = originalElement.text.split(" / ");
        for(o = 0; o < originalNames.length; o = o + 1) {
            originalName = originalNames[o].trim();
            if(originalName != "" && alternativeTitles.contains(originalName) == false) {
                alternativeTitles.push(originalName);
            }
        }
    }
    coverUrl = "";
    ogImage = document.querySelector("meta[property='og:image']");
    if(ogImage != null) {
        coverUrl = bambooAbsolute(bambooAttribute(ogImage, "content"));
    }
    description = "";
    descriptionElement = document.querySelector(".desc-block p");
    if(descriptionElement != null) {
        description = descriptionElement.text.trim();
    }
    tags = [];
    statusValue = statusUndefined();
    genreElement = bambooInfoValue(document, "Жанри");
    if(genreElement != null) {
        genreLinks = genreElement.querySelectorAll("a");
        for(g = 0; g < genreLinks.length; g = g + 1) {
            href = bambooAttribute(genreLinks[g], "href");
            if(href.endsWith("/now/")) {
                statusValue = statusOngoing();
                continue;
            }
            if(href.endsWith("/done/")) {
                statusValue = statusReleased();
                continue;
            }
            genreName = genreLinks[g].text.trim();
            if(genreName != "" && tags.contains(genreName) == false) {
                tags.push(genreName);
            }
        }
    }
    year = null;
    yearElement = bambooInfoValue(document, "Рік");
    if(yearElement != null && yearElement.text.trim().length >= 4) {
        year = parseInt(yearElement.text.trim().substring(0, 4));
    }
    countryElement = bambooInfoValue(document, "Країна");
    if(countryElement != null && countryElement.text.trim() != "") {
        tags.push(countryElement.text.trim());
    }
    return buildConcrete({
        "uid": uid,
        "title": heading.text.trim(),
        "cover": coverUrl,
        "description": description,
        "tags": tags,
        "status": statusValue,
        "alternativeTitles": alternativeTitles,
        "authors": [],
        "year": year,
        "url": bambooBaseUrl() + "/" + uid,
        "groups": bambooGroups(body, "Серії")
    });
}

function getVideoSources(uid, src, data) {
    trackName = "BambooUA";
    if(data != null && data["track"] != null && parseString(data["track"]).trim() != "") {
        trackName = parseString(data["track"]).trim();
    }
    streamFormat = "mp4";
    if(src.contains(".m3u8")) {
        streamFormat = "hls";
    }
    return [{
        "url": src,
        "quality": "Auto",
        "format": streamFormat,
        "headers": {
            "User-Agent": bambooUserAgent(),
            "Referer": bambooBaseUrl() + "/"
        },
        "audioLabel": trackName
    }];
}

function getImageHeaders(uid) {
    return {
        "User-Agent": bambooUserAgent(),
        "Referer": bambooBaseUrl() + "/"
    };
}
